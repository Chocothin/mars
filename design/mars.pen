          "fill": "#0B0D14",
          "width": 908,
          "height": 436
        },
        {
          "type": "text",
          "id": "Ix1JP",
          "x": 536,
          "y": 264,
          "name": "md-line1",
          "fill": "#F1F5F9",
          "content": "# System Prompt Template",
          "fontFamily": "Inter",
          "fontSize": 14,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "MhHtt",
          "x": 536,
          "y": 288,
          "name": "md-line2",
          "fill": "#F1F5F9",
          "content": "## Purpose",
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "H9b2Y",
          "x": 536,
          "y": 308,
          "name": "md-line3",
          "fill": "#94A3B8",
          "content": "This template defines the base system prompt used by all agents",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "0jU1D",
          "x": 536,
          "y": 326,
          "name": "md-line4",
          "fill": "#94A3B8",
          "content": "in the MARS orchestration system. It establishes core behavior",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Pzqlh",
          "x": 536,
          "y": 344,
          "name": "md-line5",
          "fill": "#94A3B8",
          "content": "patterns and safety constraints.",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "dCMwQ",
          "x": 536,
          "y": 372,
          "name": "md-line6",
          "fill": "#F1F5F9",
          "content": "## Template Variables",
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "a0vOl",
          "x": 536,
          "y": 392,
          "name": "md-line7",
          "fill": "#94A3B8",
          "content": "- `{{agent_name}}` — Name of the current agent",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "y8XPr",
          "x": 536,
          "y": 410,
          "name": "md-line8",
          "fill": "#94A3B8",
          "content": "- `{{agent_role}}` — Role description",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Y09x9",
          "x": 536,
          "y": 428,
          "name": "md-line9",
          "fill": "#94A3B8",
          "content": "- `{{project_context}}` — Active project metadata",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "fWqDp",
          "x": 536,
          "y": 446,
          "name": "md-line10",
          "fill": "#94A3B8",
          "content": "- `{{memory_context}}` — Relevant memory entries",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "75IiB",
          "x": 536,
          "y": 474,
          "name": "md-line11",
          "fill": "#F1F5F9",
          "content": "## Constraints",
          "fontFamily": "Inter",
          "fontSize": 13,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "LxLwu",
          "x": 536,
          "y": 494,
          "name": "md-line12",
          "fill": "#94A3B8",
          "content": "1. Never expose API keys or credentials",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "VeCOo",
          "x": 536,
          "y": 512,
          "name": "md-line13",
          "fill": "#94A3B8",
          "content": "2. Always confirm destructive operations",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "CQe3b",
          "x": 536,
          "y": 530,
          "name": "md-line14",
          "fill": "#94A3B8",
          "content": "3. Log all tool invocations",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "Fc3uB",
          "x": 536,
          "y": 548,
          "name": "md-line15",
          "fill": "#94A3B8",
          "content": "4. Respect rate limits and retry policies",
          "fontFamily": "Inter",
          "fontSize": 12,
          "fontWeight": "normal"
        },
        {
          "type": "text",
          "id": "NM0u9",
          "x": 520,
          "y": 264,
          "name": "md-line-numbers",
          "fill": "#4B5563",
